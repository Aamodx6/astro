---
interface Props {
  title?: string;
  description?: string;
  dataWfPage?: string;
  image?: string;
}

const {
  title = "Creative studio powering AI, brands & digital futures — Soale",
  description = "A premium AI studio and digital engineering agency. We build practical AI systems, automated workflows, and high-performance digital products for ambitious teams.",
  dataWfPage = "6880e261cef3bfa6896ed9e5",
  image = "/images/about.webp"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-wf-page={dataWfPage} class="w-mod-js w-mod-ix">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Soale Astro Themes" href="/rss.xml" />
    <link rel="canonical" href={Astro.url.href} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Google Fonts: Inter Tight & IBM Plex Mono -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500;600;700&family=Inter+Tight:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Original BaseHead CSS -->
    <link rel="stylesheet" href="/_astro/BaseHead.DDVPNTYp.css" />

    <style is:global>
      /* Ensure everything displays with complete visibility immediately */
      [style*="opacity:0"], [style*="opacity: 0"] {
        opacity: 1 !important;
        filter: none !important;
      }
      .w-slider-dot {
        background-color: #ffffff80;
        border-radius: 100px;
        width: 8px;
        height: 8px;
        margin: 0;
        transition: all 0.3s ease-in-out;
      }
      .w-slider-dot.w-active {
        background-color: #fff;
        width: 24px;
        height: 8px;
        border-radius: 100px !important;
      }

      /* Clean 2-column flexbox grid for portfolio cards without float snagging */
      .w-dyn-items.w-row {
        display: flex !important;
        flex-wrap: wrap !important;
      }
      .w-dyn-items.w-row:before,
      .w-dyn-items.w-row:after {
        display: none !important;
      }
      .collection-item.w-dyn-item.w-col.w-col-6 {
        float: none !important;
        width: 50% !important;
        display: flex !important;
        flex-direction: column !important;
        box-sizing: border-box !important;
      }
      .our-work-tab-card {
        display: flex !important;
        flex-direction: column !important;
        height: 100% !important;
        width: 100% !important;
      }
      .our-work-tab-card .work-small-image-div {
        margin-top: auto !important;
      }
      @media screen and (max-width: 767px) {
        .collection-item.w-dyn-item.w-col.w-col-6 {
          width: 100% !important;
        }
      }
    </style>
  </head>
  <body class="body">
    <slot />

    <script is:inline src="/js/jquery.min.js"></script>
    <script is:inline src="/js/site.min.js"></script>
  </body>
</html>
