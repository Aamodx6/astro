---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found — Soale"
  description="The page you are looking for does not exist or has been moved."
  dataWfPage="6880e261cef3bfa6896ed9e5"
>
  <header class="header w-nav">
    <div class="container w-container">
      <div class="nav-wrapper">
        <a href="/" class="brand-logo-link w-nav-brand">
          <img src="/images/logo.svg" alt="Soale Logo" class="logo" />
        </a>
        <nav class="nav-menu w-nav-menu">
          <div class="nav-menu-div">
            <a href="/about-us" class="nav-link w-nav-link">About us</a>
            <a href="/work" class="nav-link w-nav-link">Work</a>
            <a href="/services" class="nav-link w-nav-link">Services</a>
            <a href="/pricing" class="nav-link w-nav-link">Pricing</a>
            <a href="/blog" class="nav-link w-nav-link">Blog</a>
          </div>
        </nav>
        <div class="nav-button-div">
          
        </div>
      </div>
    </div>
  </header>

  <section class="home-hero-section" style="min-height: 80vh; display: flex; align-items: center; justify-content: center;">
    <div class="hero-circle-wrapper _404-page">
      <div class="black-background-circle _404-page"></div>
      <div class="gradient-circle _404-page"></div>
    </div>
    <div class="circle-left _404-page"></div>
    <div class="circle-left right _404-page"></div>
    <img src="/images/hero-bg.webp" alt="Hero Background" class="hero-background-image" />

    <div class="w-layout-blockcontainer container w-container" style="position: relative; z-index: 10; text-align: center;">
      <div class="hero-sub-heading-div" style="margin-left: auto; margin-right: auto;">
        <img src="/images/star.svg" alt="Star Icon" class="sub-heading-icon" />
        <div class="small-paragraph white-text hero-sub-heading-text">Error 404 | Coordinate Not Located</div>
      </div>
      <h1 class="h1-heading hero-heading" style="margin-top: 24px; font-size: clamp(3rem, 6vw, 5rem);">Page not found</h1>
      <p class="large-paragraph hero-paragraph" style="margin-top: 16px; margin-left: auto; margin-right: auto; max-width: 600px;">
        The page you are looking for doesn't exist, was renamed, or has temporarily drifted off the digital grid.
      </p>
      <div style="margin-top: 32px;">
        <a href="/" class="common-button w-button" style="padding: 16px 36px; border-radius: 100px;">Back to Homepage</a>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="w-layout-blockcontainer container w-container">
      <div class="footer-bottom-div">
        <div class="footer-detail-div">
          <a href="/" class="brand-logo-link w-inline-block">
            <img src="/images/footer-logo.svg" alt="Logo" class="footer-logo" />
          </a>
          <div class="paragraph medium-font footer-line">|</div>
          <div class="paragraph medium-font">&copy; 2026 Soale Agency. All rights reserved.</div>
        </div>
      </div>
    </div>
  </footer>
</Layout>
