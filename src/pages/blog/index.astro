---
import Layout from '../../layouts/Layout.astro';
import blogData from '../../data/blog.json';
import CtaBanner from '../../components/CtaBanner.astro';

const categories = ['All', 'Product Strategy', 'AI & Design', 'UX & Onboarding', 'Engineering'];
---

<Layout
  title="Insights & Research | Soale Astra"
  description="Deep dives into AI interface architecture, multi-agent UX, lean MVP frameworks, and design systems for ambitious founders and product teams."
>
  <!-- Blog Index Hero -->
  <section class="py-20 sm:py-28 bg-neutral-950 text-white relative overflow-hidden">
    <div class="absolute inset-0 dark-grid-backdrop opacity-25 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-neutral-900 border border-neutral-800 text-xs font-mono text-indigo-400">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
          <span>Studio Publications</span>
        </div>
        <h1 class="display-hero font-display font-extrabold tracking-tight text-white">
          Insights &amp; Research.
        </h1>
        <p class="display-subhead text-neutral-400 leading-relaxed max-w-2xl">
          Field notes, design principles, and technical strategies from our work with category-defining AI startups and digital product teams.
        </p>
      </div>
    </div>
  </section>

  <!-- Articles Collection Grid (All 13 Articles) -->
  <section class="py-16 sm:py-24 bg-neutral-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Featured Hero Post (Post 0) -->
      {blogData[0] && (
        <article class="mb-16 group rounded-3xl bg-white border border-neutral-200/90 p-6 sm:p-10 shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            <div class="lg:col-span-7">
              <a href={`/blog/${blogData[0].slug}`} class="block overflow-hidden rounded-2xl bg-neutral-200 aspect-[16/10] relative">
                <img
                  src={blogData[0].image}
                  alt={blogData[0].title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="eager"
                />
              </a>
            </div>
            <div class="lg:col-span-5 space-y-5">
              <div class="flex items-center gap-3 font-mono text-xs text-neutral-500">
                <span class="px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 font-semibold border border-indigo-200/80">
                  Featured
                </span>
                <span>•</span>
                <span>{blogData[0].category}</span>
                <span>•</span>
                <span>{blogData[0].readTime}</span>
              </div>

              <h2 class="font-display font-bold text-2xl sm:text-3xl text-neutral-950 group-hover:text-indigo-600 transition-colors leading-snug">
                <a href={`/blog/${blogData[0].slug}`}>
                  {blogData[0].title}
                </a>
              </h2>

              <p class="text-neutral-600 text-base leading-relaxed">
                {blogData[0].description}
              </p>

              <div class="pt-4 border-t border-neutral-100 flex items-center justify-between text-xs font-mono text-neutral-500">
                <span>{blogData[0].date}</span>
                <a href={`/blog/${blogData[0].slug}`} class="text-indigo-600 font-semibold group-hover:underline inline-flex items-center gap-1.5">
                  <span>Read Article</span>
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14"></path>
                    <path d="m12 5 7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </article>
      )}

      <!-- Remaining 12 Articles Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {blogData.slice(1).map((post) => (
          <article class="group rounded-2xl bg-white border border-neutral-200/90 p-6 flex flex-col justify-between hover:border-neutral-300 hover:shadow-xl transition-all duration-300">
            <div class="space-y-4">
              <a href={`/blog/${post.slug}`} class="block overflow-hidden rounded-xl bg-neutral-100 aspect-[16/10] relative">
                <img
                  src={post.image}
                  alt={post.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </a>

              <div class="flex items-center justify-between font-mono text-xs text-neutral-500 pt-1">
                <span class="px-2.5 py-0.5 rounded bg-neutral-100 text-neutral-700 font-medium">
                  {post.category}
                </span>
                <span>{post.readTime}</span>
              </div>

              <h3 class="font-display font-bold text-lg text-neutral-950 group-hover:text-indigo-600 transition-colors leading-snug">
                <a href={`/blog/${post.slug}`}>
                  {post.title}
                </a>
              </h3>

              <p class="text-neutral-600 text-sm leading-relaxed line-clamp-3">
                {post.description}
              </p>
            </div>

            <div class="pt-6 mt-6 border-t border-neutral-100 flex items-center justify-between text-xs font-mono text-neutral-500">
              <span>{post.date}</span>
              <a href={`/blog/${post.slug}`} class="text-indigo-600 font-semibold group-hover:underline inline-flex items-center gap-1">
                <span>Read</span>
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <CtaBanner />
</Layout>
