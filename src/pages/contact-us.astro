---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/site';

const serviceOptions = [
  'AI & Agentic Interface Design',
  'Product Strategy & UX Research',
  'Digital Product & UI Design',
  'Design Systems & Engineering Tokens',
  'Rapid MVP Prototyping Sprint',
  'Full Studio Partnership / Retainer'
];

const budgetRanges = [
  '$5,000 – $10,000 (Sprint Pilot)',
  '$10,000 – $25,000 (Core MVP)',
  '$25,000 – $50,000 (Comprehensive Redesign)',
  '$50,000+ (Enterprise Multi-Month)'
];
---

<Layout
  title="Contact Us & Project Scoping | Soale Astra"
  description="Initiate a project with Soale Astra. Share your product roadmap, AI interface challenge, or design system requirements for a direct consultation."
>
  <section class="py-20 sm:py-28 bg-neutral-950 text-white relative overflow-hidden">
    <div class="absolute inset-0 dark-grid-backdrop opacity-25 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-neutral-900 border border-neutral-800 text-xs font-mono text-emerald-400">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Now Booking Q1/Q2 Sprints</span>
        </div>
        <h1 class="display-hero font-display font-extrabold tracking-tight text-white">
          Let’s build something remarkable.
        </h1>
        <p class="display-subhead text-neutral-400 leading-relaxed max-w-2xl">
          Talk directly with our creative director and product strategists. No gatekeepers, no sales pitches — just a candid conversation about what your product needs to win.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-28 bg-neutral-50 text-neutral-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        
        <!-- Left Contact Info Column -->
        <div class="lg:col-span-5 space-y-10">
          
          <div class="space-y-4">
            <h2 class="font-display font-bold text-2xl text-neutral-950">
              Direct Communication
            </h2>
            <p class="text-neutral-600 text-sm leading-relaxed">
              Prefer skipping forms? Reach our studio desk directly or schedule a 30-minute scoping session.
            </p>
          </div>

          <div class="space-y-6">
            <div class="p-6 rounded-2xl bg-white border border-neutral-200/90 shadow-sm space-y-2">
              <div class="text-xs font-mono uppercase text-neutral-400 font-semibold tracking-wider">Direct Email</div>
              <a href={`mailto:${siteConfig.email}`} class="font-mono text-base sm:text-lg font-bold text-indigo-600 hover:text-indigo-700 hover:underline">
                {siteConfig.email}
              </a>
              <div class="text-xs text-neutral-500 font-mono pt-1">Typical response time: Under 12 hours</div>
            </div>

            <div class="p-6 rounded-2xl bg-white border border-neutral-200/90 shadow-sm space-y-2">
              <div class="text-xs font-mono uppercase text-neutral-400 font-semibold tracking-wider">Studio Locations</div>
              <div class="font-display font-bold text-neutral-900 text-base">{siteConfig.location}</div>
              <div class="text-xs text-neutral-500 font-mono">Operating across PT, ET, and GMT timezones</div>
            </div>

            <div class="p-6 rounded-2xl bg-neutral-950 text-white space-y-3">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                <span class="text-xs font-mono uppercase tracking-wider text-emerald-400 font-semibold">Discovery Guarantee</span>
              </div>
              <p class="text-xs text-neutral-300 leading-relaxed font-normal">
                Every inquiry is reviewed by our creative director. If we are not the right studio for your timeline or stack, we will gladly refer you to trusted partner practices in our network.
              </p>
            </div>
          </div>

        </div>

        <!-- Right Inquiry Form Column -->
        <div class="lg:col-span-7">
          <div class="rounded-3xl bg-white border border-neutral-200/90 p-8 sm:p-12 shadow-sm">
            
            <form id="studio-contact-form" class="space-y-6" novalidate>
              
              <!-- Name & Email Row -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label for="contact-name" class="block text-xs font-mono uppercase tracking-wider text-neutral-700 font-semibold mb-2">
                    Your Name <span class="text-rose-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="contact-name"
                    name="name"
                    required
                    placeholder="Elena Vance"
                    class="w-full px-4 py-3 rounded-xl border border-neutral-200 bg-neutral-50 text-neutral-900 text-sm focus:bg-white focus:border-indigo-600 transition-colors"
                  />
                  <span class="error-msg text-xs text-rose-500 font-mono mt-1 hidden" id="name-error">Please provide your name.</span>
                </div>

                <div>
                  <label for="contact-email" class="block text-xs font-mono uppercase tracking-wider text-neutral-700 font-semibold mb-2">
                    Work Email <span class="text-rose-500">*</span>
                  </label>
                  <input
                    type="email"
                    id="contact-email"
                    name="email"
                    required
                    placeholder="elena@company.com"
                    class="w-full px-4 py-3 rounded-xl border border-neutral-200 bg-neutral-50 text-neutral-900 text-sm focus:bg-white focus:border-indigo-600 transition-colors"
                  />
                  <span class="error-msg text-xs text-rose-500 font-mono mt-1 hidden" id="email-error">Please provide a valid email.</span>
                </div>
              </div>

              <!-- Company & Website -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label for="contact-company" class="block text-xs font-mono uppercase tracking-wider text-neutral-700 font-semibold mb-2">
                    Company / Project
                  </label>
                  <input
                    type="text"
                    id="contact-company"
                    name="company"
                    placeholder="NeuronIQ AI"
                    class="w-full px-4 py-3 rounded-xl border border-neutral-200 bg-neutral-50 text-neutral-900 text-sm focus:bg-white focus:border-indigo-600 transition-colors"
                  />
                </div>

                <div>
                  <label for="contact-website" class="block text-xs font-mono uppercase tracking-wider text-neutral-700 font-semibold mb-2">
                    Current Website (If Live)
                  </label>
                  <input
                    type="url"
                    id="contact-website"
                    name="website"
                    placeholder="https://example.com"
                    class="w-full px-4 py-3 rounded-xl border border-neutral-200 bg-neutral-50 text-neutral-900 text-sm focus:bg-white focus:border-indigo-600 transition-colors"
                  />
                </div>
              </div>

              <!-- Service Required Dropdown -->
              <div>
                <label for="contact-service" class="block text-xs font-mono uppercase tracking-wider text-neutral-700 font-semibold mb-2">
                  Primary Need / Discipline <span class="text-rose-500">*</span>
                </label>
                <select
                  id="contact-service"
                  name="service"
                  required
                  class="w-full px-4 py-3 rounded-xl border border-neutral-200 bg-neutral-50 text-neutral-900 text-sm focus:bg-white focus:border-indigo-600 transition-colors"
                >
                  <option value="" disabled selected>Select studio capability...</option>
                  {serviceOptions.map((opt) => (
                    <option value={opt}>{opt}</option>
                  ))}
                </select>
                <span class="error-msg text-xs text-rose-500 font-mono mt-1 hidden" id="service-error">Please select a service.</span>
              </div>

              <!-- Estimated Budget Range -->
              <div>
                <label for="contact-budget" class="block text-xs font-mono uppercase tracking-wider text-neutral-700 font-semibold mb-2">
                  Estimated Budget Scope <span class="text-rose-500">*</span>
                </label>
                <select
                  id="contact-budget"
                  name="budget"
                  required
                  class="w-full px-4 py-3 rounded-xl border border-neutral-200 bg-neutral-50 text-neutral-900 text-sm focus:bg-white focus:border-indigo-600 transition-colors"
                >
                  <option value="" disabled selected>Select budget range...</option>
                  {budgetRanges.map((b) => (
                    <option value={b}>{b}</option>
                  ))}
                </select>
                <span class="error-msg text-xs text-rose-500 font-mono mt-1 hidden" id="budget-error">Please select a budget range.</span>
              </div>

              <!-- Project Details -->
              <div>
                <label for="contact-message" class="block text-xs font-mono uppercase tracking-wider text-neutral-700 font-semibold mb-2">
                  Project Brief &amp; Roadmap Goals <span class="text-rose-500">*</span>
                </label>
                <textarea
                  id="contact-message"
                  name="message"
                  rows="4"
                  required
                  placeholder="Tell us about the product you are building, key UX friction points, and your target timeline..."
                  class="w-full px-4 py-3 rounded-xl border border-neutral-200 bg-neutral-50 text-neutral-900 text-sm focus:bg-white focus:border-indigo-600 transition-colors"
                ></textarea>
                <span class="error-msg text-xs text-rose-500 font-mono mt-1 hidden" id="message-error">Please provide a brief description.</span>
              </div>

              <!-- Submit Button -->
              <div>
                <button
                  type="submit"
                  id="submit-btn"
                  class="w-full py-4 px-6 text-sm font-semibold text-white bg-neutral-950 rounded-xl hover:bg-indigo-600 transition-all duration-200 shadow-md flex items-center justify-center gap-2 cursor-pointer"
                >
                  <span id="btn-text">Submit Project Inquiry</span>
                  <svg id="btn-arrow" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M5 12h14"></path>
                    <path d="m12 5 7 7-7 7"></path>
                  </svg>
                  <div id="btn-spinner" class="hidden w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                </button>
              </div>

              <div class="text-center text-xs font-mono text-neutral-400">
                🔒 Strict Confidentiality • Non-Disclosure Agreement (NDA) respected upon request
              </div>

            </form>

            <!-- Success Confirmation Card (Revealed on submission) -->
            <div id="success-card" class="hidden text-center py-12 space-y-5">
              <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 mx-auto flex items-center justify-center text-2xl font-bold">
                ✓
              </div>
              <h3 class="font-display font-bold text-2xl text-neutral-950">
                Inquiry Successfully Logged!
              </h3>
              <p class="text-neutral-600 text-sm max-w-md mx-auto leading-relaxed">
                Thank you for reaching out. Your brief has been forwarded directly to our partners desk. You will receive an initial response within 12 business hours.
              </p>
              <div class="p-4 rounded-xl bg-neutral-100 font-mono text-xs text-neutral-700 max-w-xs mx-auto">
                Reference ID: <span class="font-bold text-indigo-600" id="ref-id">SA-9482</span>
              </div>
              <div class="pt-4">
                <a
                  href="/work"
                  class="inline-flex items-center gap-2 text-xs font-semibold text-indigo-600 hover:underline"
                >
                  <span>Explore our case studies while you wait →</span>
                </a>
              </div>
            </div>

          </div>
        </div>

      </div>

    </div>
  </section>
</Layout>

<script is:inline>
  const form = document.getElementById('studio-contact-form');
  const successCard = document.getElementById('success-card');
  const submitBtn = document.getElementById('submit-btn');
  const btnText = document.getElementById('btn-text');
  const btnArrow = document.getElementById('btn-arrow');
  const btnSpinner = document.getElementById('btn-spinner');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      let isValid = true;
      const name = document.getElementById('contact-name');
      const email = document.getElementById('contact-email');
      const service = document.getElementById('contact-service');
      const budget = document.getElementById('contact-budget');
      const message = document.getElementById('contact-message');

      // Validation
      if (!name.value.trim()) {
        document.getElementById('name-error').classList.remove('hidden');
        isValid = false;
      } else {
        document.getElementById('name-error').classList.add('hidden');
      }

      if (!email.value.trim() || !email.value.includes('@') || !email.value.includes('.')) {
        document.getElementById('email-error').classList.remove('hidden');
        isValid = false;
      } else {
        document.getElementById('email-error').classList.add('hidden');
      }

      if (!service.value) {
        document.getElementById('service-error').classList.remove('hidden');
        isValid = false;
      } else {
        document.getElementById('service-error').classList.add('hidden');
      }

      if (!budget.value) {
        document.getElementById('budget-error').classList.remove('hidden');
        isValid = false;
      } else {
        document.getElementById('budget-error').classList.add('hidden');
      }

      if (!message.value.trim()) {
        document.getElementById('message-error').classList.remove('hidden');
        isValid = false;
      } else {
        document.getElementById('message-error').classList.add('hidden');
      }

      if (!isValid) return;

      // Loading state
      btnText.textContent = 'Encrypting & Transmitting...';
      btnArrow.classList.add('hidden');
      btnSpinner.classList.remove('hidden');
      submitBtn.disabled = true;

      setTimeout(() => {
        // Generate random ref id
        const randomNum = Math.floor(1000 + Math.random() * 9000);
        const refEl = document.getElementById('ref-id');
        if (refEl) refEl.textContent = `SA-${randomNum}`;

        form.classList.add('hidden');
        successCard.classList.remove('hidden');
      }, 750);
    });
  }
</script>
