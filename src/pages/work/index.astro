---
import Layout from '../../layouts/Layout.astro';
import workData from '../../data/work.json';
import CtaBanner from '../../components/CtaBanner.astro';

const categories = [
  'All',
  'Agentic AI & LLMs',
  'AI Analytics',
  'Fintech & Mobile',
  'Digital Health & Care',
  'Design Systems',
  'E-Commerce & Fintech',
  'IoT & Smart Living'
];
---

<Layout
  title="Selected Work & Case Studies | Soale Astra"
  description="Explore our archive of 9 end-to-end digital product design case studies across AI interfaces, fintech apps, healthcare dashboards, and design systems."
>
  <!-- Work Index Hero -->
  <section class="py-20 sm:py-28 bg-neutral-950 text-white relative overflow-hidden">
    <div class="absolute inset-0 dark-grid-backdrop opacity-25 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-neutral-900 border border-neutral-800 text-xs font-mono text-indigo-400">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
          <span>Studio Portfolio Index</span>
        </div>
        <h1 class="display-hero font-display font-extrabold tracking-tight text-white">
          Selected Work.
        </h1>
        <p class="display-subhead text-neutral-400 leading-relaxed max-w-2xl">
          A showcase of complex interface challenges transformed into clean, high-velocity digital experiences. Every project reflects disciplined UX architecture and uncompromising visual taste.
        </p>
      </div>
    </div>
  </section>

  <!-- Filter & Projects Section -->
  <section class="py-16 sm:py-24 bg-neutral-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Interactive Category Filter Chips -->
      <div class="flex items-center gap-2 overflow-x-auto pb-4 scrollbar-none" id="filter-container">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-category={cat}
            class={`category-filter-btn px-4 py-2 text-xs sm:text-sm font-medium rounded-full transition-all whitespace-nowrap cursor-pointer ${
              idx === 0
                ? 'bg-neutral-950 text-white shadow-sm active-filter'
                : 'bg-white text-neutral-600 border border-neutral-200 hover:border-neutral-300 hover:text-neutral-950'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Projects Grid (All 9 Projects) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 pt-12" id="projects-grid">
        {workData.map((project) => (
          <article
            class="project-card group rounded-2xl bg-white border border-neutral-200/90 p-6 flex flex-col justify-between hover:border-neutral-300 hover:shadow-xl transition-all duration-300"
            data-category={project.category}
          >
            <div class="space-y-4">
              <!-- Thumbnail -->
              <a href={`/work/${project.slug}`} class="block overflow-hidden rounded-xl bg-neutral-100 aspect-[16/10] relative group-hover:shadow-md transition-shadow">
                <img
                  src={project.heroImage}
                  alt={project.title}
                  class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </a>

              <!-- Meta -->
              <div class="flex items-center justify-between font-mono text-xs text-neutral-500 pt-1">
                <span class="px-2.5 py-0.5 rounded bg-neutral-100 text-neutral-700 font-medium">
                  {project.category}
                </span>
                <span>{project.year}</span>
              </div>

              <!-- Title -->
              <h2 class="font-display font-bold text-xl text-neutral-950 group-hover:text-indigo-600 transition-colors leading-snug">
                <a href={`/work/${project.slug}`}>
                  {project.title}
                </a>
              </h2>

              <!-- Description -->
              <p class="text-neutral-600 text-sm leading-relaxed line-clamp-3">
                {project.overview}
              </p>

              <!-- Deliverables -->
              <div class="pt-2 flex flex-wrap gap-1">
                {project.deliverables.slice(0, 3).map((d) => (
                  <span class="px-2 py-0.5 rounded bg-neutral-100 text-[11px] font-mono text-neutral-600">
                    {d}
                  </span>
                ))}
              </div>
            </div>

            <!-- Bottom Link -->
            <div class="pt-6 mt-6 border-t border-neutral-100 flex items-center justify-between">
              <span class="text-xs font-mono text-neutral-400">{project.client}</span>
              <a
                href={`/work/${project.slug}`}
                class="text-xs font-semibold text-indigo-600 group-hover:text-indigo-700 hover:underline inline-flex items-center gap-1"
              >
                <span>View Case Study</span>
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </a>
            </div>

          </article>
        ))}
      </div>

      <!-- No items found state -->
      <div id="no-projects-msg" class="hidden text-center py-20">
        <p class="text-neutral-500 text-base font-mono">No case studies match this filter.</p>
        <button
          type="button"
          id="reset-filter-btn"
          class="mt-4 px-4 py-2 text-xs font-semibold bg-neutral-950 text-white rounded-lg hover:bg-indigo-600 transition-colors"
        >
          Show All Projects
        </button>
      </div>

    </div>
  </section>

  <CtaBanner />
</Layout>

<script is:inline>
  const filterBtns = document.querySelectorAll('.category-filter-btn');
  const projectCards = document.querySelectorAll('.project-card');
  const noProjectsMsg = document.getElementById('no-projects-msg');
  const resetBtn = document.getElementById('reset-filter-btn');

  function applyFilter(category) {
    let visibleCount = 0;

    filterBtns.forEach(btn => {
      const match = btn.getAttribute('data-category') === category;
      if (match) {
        btn.classList.add('bg-neutral-950', 'text-white', 'shadow-sm', 'active-filter');
        btn.classList.remove('bg-white', 'text-neutral-600', 'border');
      } else {
        btn.classList.remove('bg-neutral-950', 'text-white', 'shadow-sm', 'active-filter');
        btn.classList.add('bg-white', 'text-neutral-600', 'border');
      }
    });

    projectCards.forEach(card => {
      const cardCategory = card.getAttribute('data-category');
      if (category === 'All' || cardCategory === category) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (noProjectsMsg) {
      if (visibleCount === 0) noProjectsMsg.classList.remove('hidden');
      else noProjectsMsg.classList.add('hidden');
    }
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-category');
      applyFilter(cat);
    });
  });

  if (resetBtn) {
    resetBtn.addEventListener('click', () => applyFilter('All'));
  }
</script>
