---
import Layout from '../../layouts/Layout.astro';
import workData from '../../data/work.json';
import CtaBanner from '../../components/CtaBanner.astro';

export async function getStaticPaths() {
  return workData.map((project, idx) => {
    const prevProject = idx > 0 ? workData[idx - 1] : workData[workData.length - 1];
    const nextProject = idx < workData.length - 1 ? workData[idx + 1] : workData[0];
    return {
      params: { slug: project.slug },
      props: { project, prevProject, nextProject }
    };
  });
}

const { project, prevProject, nextProject } = Astro.props;
---

<Layout
  title={`${project.title} — Case Study | Soale Astra`}
  description={project.overview || project.description}
  image={project.heroImage}
>
  <!-- Case Study Header -->
  <section class="py-16 sm:py-24 bg-neutral-950 text-white relative overflow-hidden">
    <div class="absolute inset-0 dark-grid-backdrop opacity-20 pointer-events-none"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <div class="space-y-6 max-w-4xl">
        <!-- Back Breadcrumb -->
        <a href="/work" class="inline-flex items-center gap-2 text-xs font-mono text-neutral-400 hover:text-white transition-colors">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="m15 18-6-6 6-6"></path>
          </svg>
          <span>Back to All Work</span>
        </a>

        <!-- Category & Year -->
        <div class="flex items-center gap-3 font-mono text-xs text-neutral-400">
          <span class="px-3 py-1 rounded-full bg-neutral-900 border border-neutral-800 text-indigo-400 font-semibold">
            {project.category}
          </span>
          <span>•</span>
          <span>{project.year}</span>
          <span>•</span>
          <span>Client: {project.client}</span>
        </div>

        <h1 class="display-section font-display font-extrabold tracking-tight text-white">
          {project.title}
        </h1>

        <p class="display-subhead text-neutral-300 font-normal leading-relaxed">
          {project.overview}
        </p>

        <!-- Deliverables Chips -->
        <div class="pt-4 flex flex-wrap gap-2">
          {project.deliverables.map((item) => (
            <span class="px-3 py-1 rounded-md bg-neutral-900 border border-neutral-800 text-xs font-mono text-neutral-300">
              {item}
            </span>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- Large Showcase Image Preview -->
  <section class="bg-neutral-900 py-10 border-b border-neutral-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl overflow-hidden bg-neutral-950 border border-neutral-800 shadow-2xl">
        <img
          src={project.heroImage}
          alt={`${project.title} Full Showcase`}
          class="w-full h-auto object-cover max-h-[700px] object-top"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- Narrative Breakdown: Problem, Architecture, Solution -->
  <section class="py-20 sm:py-28 bg-white text-neutral-900">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        
        <!-- Left Sticky Metadata Sidebar -->
        <div class="lg:col-span-4 space-y-8 lg:sticky lg:top-28 self-start">
          <div class="rounded-2xl bg-neutral-50 border border-neutral-200/90 p-6 space-y-6">
            <h3 class="font-mono text-xs uppercase tracking-wider text-neutral-400 font-semibold">
              Project Parameters
            </h3>

            <div>
              <div class="text-xs font-mono text-neutral-500">Client Partner</div>
              <div class="font-display font-bold text-neutral-900 text-base mt-0.5">{project.client}</div>
            </div>

            <div>
              <div class="text-xs font-mono text-neutral-500">Sector</div>
              <div class="font-display font-medium text-neutral-800 text-sm mt-0.5">{project.category}</div>
            </div>

            <div>
              <div class="text-xs font-mono text-neutral-500">Studio Deliverables</div>
              <ul class="mt-2 space-y-1.5 text-xs text-neutral-700">
                {project.deliverables.map(d => (
                  <li class="flex items-center gap-2">
                    <span class="text-indigo-600 font-bold">✓</span>
                    <span>{d}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-4 border-t border-neutral-200">
              <a
                href="/contact-us"
                class="w-full py-2.5 px-4 text-center text-xs font-semibold text-white bg-neutral-950 rounded-xl hover:bg-indigo-600 transition-colors block shadow-sm"
              >
                Inquire Similar Project
              </a>
            </div>
          </div>
        </div>

        <!-- Right Main Case Study Content -->
        <div class="lg:col-span-8 space-y-16">
          
          <!-- Overview Section -->
          <div class="space-y-4">
            <div class="text-xs font-mono uppercase tracking-wider text-indigo-600 font-semibold">
              01 // The Executive Context
            </div>
            <h2 class="font-display font-bold text-2xl sm:text-3xl text-neutral-950 tracking-tight">
              Overview &amp; Product Context
            </h2>
            <p class="text-neutral-700 text-base sm:text-lg leading-relaxed">
              {project.overview}
            </p>
          </div>

          <!-- Challenge Section -->
          <div class="space-y-4 pt-8 border-t border-neutral-100">
            <div class="text-xs font-mono uppercase tracking-wider text-rose-600 font-semibold">
              02 // The Problem Space
            </div>
            <h2 class="font-display font-bold text-2xl sm:text-3xl text-neutral-950 tracking-tight">
              The Critical Challenge
            </h2>
            <div class="p-6 rounded-2xl bg-neutral-50 border-l-4 border-rose-500 text-neutral-700 text-base sm:text-lg leading-relaxed">
              {project.challenge}
            </div>
          </div>

          <!-- Solution Section -->
          <div class="space-y-4 pt-8 border-t border-neutral-100">
            <div class="text-xs font-mono uppercase tracking-wider text-emerald-600 font-semibold">
              03 // Engineering &amp; Interface Design
            </div>
            <h2 class="font-display font-bold text-2xl sm:text-3xl text-neutral-950 tracking-tight">
              The Studio Solution
            </h2>
            <p class="text-neutral-700 text-base sm:text-lg leading-relaxed">
              {project.solution}
            </p>
          </div>

          <!-- Supporting Gallery Images if present -->
          {project.galleryImages && project.galleryImages.length > 0 && (
            <div class="space-y-6 pt-8 border-t border-neutral-100">
              <h3 class="font-display font-bold text-xl text-neutral-950">
                Interface Artifacts &amp; Deep System Views
              </h3>
              <div class="grid grid-cols-1 gap-6">
                {project.galleryImages.map((img, i) => (
                  <div class="rounded-2xl overflow-hidden border border-neutral-200 bg-neutral-50 shadow-sm">
                    <img
                      src={img}
                      alt={`${project.title} detail artifact ${i + 1}`}
                      class="w-full h-auto object-cover"
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>
            </div>
          )}

        </div>

      </div>

    </div>
  </section>

  <!-- Next / Previous Case Study Navigation -->
  <section class="py-12 bg-neutral-100 border-t border-b border-neutral-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        
        <a
          href={`/work/${prevProject.slug}`}
          class="group p-6 rounded-2xl bg-white border border-neutral-200 hover:border-neutral-300 hover:shadow-md transition-all flex flex-col justify-between"
        >
          <div class="text-xs font-mono text-neutral-400 uppercase tracking-wider mb-2">← Previous Project</div>
          <div class="font-display font-bold text-lg text-neutral-950 group-hover:text-indigo-600 transition-colors">
            {prevProject.title}
          </div>
          <div class="text-xs font-mono text-neutral-500 mt-1">{prevProject.category}</div>
        </a>

        <a
          href={`/work/${nextProject.slug}`}
          class="group p-6 rounded-2xl bg-white border border-neutral-200 hover:border-neutral-300 hover:shadow-md transition-all flex flex-col justify-between text-right"
        >
          <div class="text-xs font-mono text-neutral-400 uppercase tracking-wider mb-2">Next Project →</div>
          <div class="font-display font-bold text-lg text-neutral-950 group-hover:text-indigo-600 transition-colors">
            {nextProject.title}
          </div>
          <div class="text-xs font-mono text-neutral-500 mt-1">{nextProject.category}</div>
        </a>

      </div>
    </div>
  </section>

  <CtaBanner />
</Layout>
