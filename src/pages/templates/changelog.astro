---
import Layout from '../../layouts/Layout.astro';

const updates = [
  {
    version: 'v2.4.0',
    date: 'October 2026',
    title: 'Complete Studio Redesign & Architecture Elevation',
    notes: [
      'Engineered complete custom Astro static architecture, eliminating all Webflow runtime and jQuery baggage.',
      'Constructed new high-contrast editorial art direction with Plus Jakarta Sans and JetBrains Mono.',
      'Implemented real-time client-side interactive monthly/annual pricing calculator with 20% savings.',
      'Added interactive multi-category case study filtering across all 9 portfolio projects.',
      'Upgraded WCAG 2.2 AA accessibility score, visible keyboard focus rings, and dark/light narrative pacing.'
    ]
  },
  {
    version: 'v2.1.0',
    date: 'August 2026',
    title: 'Agentic UX & Prompt Ergonomics Practice Launch',
    notes: [
      'Published field research on multi-agent workflow cognitive loads.',
      'Standardized token streaming latency guidelines across all client AI dashboards.',
      'Introduced Sprint MVP 2-week zero-to-one validation framework.'
    ]
  },
  {
    version: 'v1.8.0',
    date: 'March 2026',
    title: 'Design System Token Automation',
    notes: [
      'Integrated Figma REST API token pipelines into Git repositories for automated Tailwind variables.',
      'Expanded client design roster across healthcare, devtools, and fintech verticals.'
    ]
  }
];
---

<Layout
  title="Studio Changelog & System Releases | Soale Astra"
  description="Historical release log of design system evolutions, studio methodology upgrades, and architectural enhancements at Soale Astra."
>
  <section class="py-20 sm:py-28 bg-neutral-950 text-white relative overflow-hidden">
    <div class="absolute inset-0 dark-grid-backdrop opacity-20 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <h1 class="display-hero font-display font-extrabold tracking-tight text-white">
          Changelog
        </h1>
        <p class="display-subhead text-neutral-400 leading-relaxed max-w-2xl">
          Continuous iteration and refinement across our studio architecture, design systems, and public resources.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-28 bg-white text-neutral-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      {updates.map((up) => (
        <div class="border-l-2 border-indigo-600 pl-6 sm:pl-8 space-y-4">
          <div class="flex items-center gap-3 font-mono text-xs text-neutral-500">
            <span class="px-2.5 py-0.5 rounded bg-indigo-50 border border-indigo-200 text-indigo-700 font-bold">
              {up.version}
            </span>
            <span>•</span>
            <span>{up.date}</span>
          </div>

          <h2 class="font-display font-bold text-2xl text-neutral-950">
            {up.title}
          </h2>

          <ul class="space-y-2 text-sm text-neutral-600">
            {up.notes.map((note) => (
              <li class="flex items-start gap-2.5">
                <span class="text-indigo-600 font-bold">✓</span>
                <span>{note}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Layout>
