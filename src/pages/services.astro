---
import Layout from '../layouts/Layout.astro';
import {
  aiServicesData,
  engagementProcess,
  intendedOutcomes,
  techEcosystem,
  servicesFaqs
} from '../data/ai-services';
---

<Layout
  title="AI Services & Solutions for Businesses — Soale"
  description="We design, build, and integrate intelligent systems that automate operations, improve customer experiences, and turn complex business processes into scalable workflows."
  dataWfPage="6880e261cef3bfa6896ed9e5"
>
  <!-- Header / Nav -->
  <header class="header w-nav">
    <div class="container w-container">
      <div class="nav-wrapper">
        <a href="/" class="brand-logo-link w-nav-brand">
          <img src="/images/logo.svg" loading="eager" alt="Soale Logo" class="logo" />
        </a>
        <nav class="nav-menu w-nav-menu">
          <div class="nav-menu-div">
            <a href="/about-us" class="nav-link w-nav-link">About us</a>
            <a href="/work" class="nav-link w-nav-link">Work</a>
            <a href="/services" class="nav-link w-nav-link w--current">Services</a>
            <a href="/pricing" class="nav-link w-nav-link">Pricing</a>
            <a href="/blog" class="nav-link w-nav-link">Blog</a>
          </div>
        </nav>
        <div class="nav-button-div">
          <a href="/contact-us" class="common-button nav-button w-button">Book 1:1 Meeting</a>
        </div>
      </div>
    </div>
  </header>

  <!-- SECTION A: SERVICES HERO -->
  <section class="home-hero-section" style="padding-top: 140px; padding-bottom: 100px;">
    <div class="hero-circle-wrapper">
      <div class="black-background-circle"></div>
      <div class="gradient-circle"></div>
    </div>
    <div class="circle-left right"></div>
    <div class="circle-left"></div>
    <img src="/images/hero-bg.webp" loading="eager" alt="Hero Background" class="hero-background-image" />

    <div class="w-layout-blockcontainer container w-container" style="position: relative; z-index: 10;">
      <div class="hero-detail-div">
        
        <div class="hero-sub-heading-div">
          <img src="/images/star.svg" loading="eager" alt="star icon" width="12" height="12" class="sub-heading-icon" />
          <div class="small-paragraph white-text hero-sub-heading-text">AI SOLUTIONS &amp; ENGINEERING | FOR BUSINESSES WORLDWIDE</div>
        </div>

        <h1 class="h1-heading hero-heading" style="margin-top: 20px;">
          AI That Works for Your Business.
        </h1>

        <p class="large-paragraph hero-paragraph" style="max-width: 760px; margin-left: auto; margin-right: auto; margin-top: 16px;">
          We design, build, and integrate intelligent systems that automate operations, improve customer experiences, and turn complex business processes into scalable workflows.
        </p>

        <!-- CTA Buttons -->
        <div style="display: flex; gap: 16px; justify-content: center; align-items: center; margin-top: 36px; flex-wrap: wrap;">
          <a href="/contact-us" class="common-button w-button" style="padding: 16px 36px; border-radius: 100px; font-weight: 600;">
            Book an AI Consultation ↗
          </a>
          <a href="#service-catalog" class="common-button outline-button w-button" style="padding: 16px 32px; border-radius: 100px; border-color: rgba(255,255,255,0.25);">
            Explore Service Catalog ↓
          </a>
        </div>

        <!-- Trust highlights -->
        <div style="margin-top: 50px; display: flex; justify-content: center; gap: 32px; font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: rgba(255,255,255,0.6); flex-wrap: wrap;">
          <span>✓ Custom to Your Workflows</span>
          <span>✓ Existing Stack Integration</span>
          <span>✓ Human Escalation Safeguards</span>
          <span>✓ Production-Ready Security</span>
        </div>

      </div>
    </div>
  </section>

  <!-- SECTION B: SERVICE NAVIGATION PILLS -->
  <section style="background-color: #0c0c0c; border-top: 1px solid #1a1a1a; border-bottom: 1px solid #1a1a1a; padding: 20px 0; position: sticky; top: 70px; z-index: 40; backdrop-filter: blur(12px);">
    <div class="w-layout-blockcontainer container w-container">
      <div style="display: flex; gap: 10px; overflow-x: auto; padding-bottom: 6px; justify-content: center; flex-wrap: wrap;" class="scrollbar-none">
        {aiServicesData.map((s) => (
          <a
            href={`#${s.id}`}
            class="service-nav-pill"
            style="background: #181818; color: #e0e0e0; border: 1px solid #282828; padding: 8px 18px; border-radius: 100px; font-size: 13px; text-decoration: none; white-space: nowrap; transition: all 0.2s ease;"
          >
            <span style="color: #ff7023; font-family: 'IBM Plex Mono', monospace; margin-right: 6px;">{s.number}</span>
            {s.title}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION C: THE FIVE-SERVICE CATALOG -->
  <section id="service-catalog" class="section" style="padding-top: 100px; padding-bottom: 100px; background-color: #000000;">
    <div class="w-layout-blockcontainer container w-container">
      
      <div class="common-heading-div" style="text-align: center; max-width: 800px; margin-left: auto; margin-right: auto; margin-bottom: 60px;">
        <div class="small-paragraph" style="color: #ff7023; font-family: 'IBM Plex Mono', monospace; letter-spacing: 2px;">SERVICE CATALOG</div>
        <h2 class="h2-heading" style="margin-top: 12px;">Five Practical Ways We Implement AI</h2>
        <p class="large-paragraph" style="color: rgba(255,255,255,0.7); margin-top: 16px;">
          Tailored systems built to solve specific operational friction points, integrate with your current software, and deliver measurable ROI.
        </p>
      </div>

      <!-- 5-Card Responsive Grid -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px;">
        {aiServicesData.map((service) => (
          <div
            style="background: #0a0a0a; border: 1px solid #1f1f1f; border-radius: 20px; padding: 36px 30px; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.3s ease, border-color 0.3s ease;"
            class="service-catalog-card"
          >
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: #ff7023; background: rgba(255,112,35,0.1); border: 1px solid rgba(255,112,35,0.25); padding: 4px 12px; border-radius: 100px;">
                  {service.number} // {service.category.toUpperCase()}
                </span>
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: rgba(255,255,255,0.5);">
                  {service.indicativePricing}
                </span>
              </div>

              <h3 style="font-size: 24px; font-weight: 700; color: #ffffff; margin-bottom: 12px; line-height: 1.3;">
                {service.title}
              </h3>

              <p style="font-size: 15px; color: rgba(255,255,255,0.75); line-height: 1.6; margin-bottom: 24px;">
                {service.shortDescription}
              </p>

              <!-- Key capabilities -->
              <div style="border-top: 1px solid #1a1a1a; padding-top: 18px; margin-bottom: 20px;">
                <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 10px;">
                  Core Capabilities
                </div>
                <ul style="list-style: none; padding: 0; margin: 0; font-size: 13px; color: rgba(255,255,255,0.85); line-height: 1.8;">
                  {service.servicesIncluded.slice(0, 3).map((item) => (
                    <li style="display: flex; align-items: flex-start; gap: 8px;">
                      <span style="color: #ff7023;">✓</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Tech hints -->
              <div style="display: flex; flex-wrap: gap; gap: 6px; margin-bottom: 24px;">
                {service.technology.slice(0, 4).map((tech) => (
                  <span style="background: #141414; border: 1px solid #222; color: rgba(255,255,255,0.6); font-family: 'IBM Plex Mono', monospace; font-size: 11px; padding: 3px 8px; border-radius: 4px;">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <div style="border-top: 1px solid #1a1a1a; padding-top: 20px; display: flex; justify-content: space-between; align-items: center;">
              <a
                href={`#${service.id}`}
                style="color: #ffffff; text-decoration: none; font-size: 13px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;"
              >
                <span>Deep Details</span>
                <span style="color: #ff7023;">↓</span>
              </a>
              <a
                href={`/contact-us?service=${service.id}`}
                class="common-button w-button"
                style="padding: 8px 18px; font-size: 13px; border-radius: 100px;"
              >
                {service.primaryCta}
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- SECTION D: INDIVIDUAL SERVICE DETAILS (5 EXTENSIVE SECTIONS) -->
  <section class="section" style="background-color: #050505; padding-top: 80px; padding-bottom: 120px;">
    <div class="w-layout-blockcontainer container w-container" style="display: flex; flex-direction: column; gap: 100px;">
      
      {aiServicesData.map((service, index) => {
        const isReversed = index % 2 === 1;
        return (
          <article
            id={service.id}
            style="background: #0c0c0c; border: 1px solid #1e1e1e; border-radius: 28px; padding: 48px; position: relative; scroll-margin-top: 140px;"
          >
            <!-- Top Category Bar -->
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #1a1a1a; padding-bottom: 24px; margin-bottom: 36px; flex-wrap: wrap; gap: 12px;">
              <div style="display: flex; align-items: center; gap: 12px;">
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: 20px; font-weight: 700; color: #ff7023;">
                  SERVICE {service.number}
                </span>
                <span style="color: #333;">|</span>
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: rgba(255,255,255,0.6); text-transform: uppercase;">
                  {service.category}
                </span>
              </div>
              <span style="background: rgba(255,112,35,0.12); border: 1px solid rgba(255,112,35,0.3); color: #ff7023; font-family: 'IBM Plex Mono', monospace; font-size: 11px; padding: 4px 14px; border-radius: 100px;">
                {service.badge}
              </span>
            </div>

            <!-- Two-Column Layout -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 48px;">
              
              <!-- Left Column: Problem, Solution & Narrative -->
              <div style="display: flex; flex-direction: column; gap: 24px;">
                <div>
                  <h2 style="font-size: clamp(26px, 3.5vw, 36px); font-weight: 700; color: #ffffff; line-height: 1.25; margin-bottom: 12px;">
                    {service.title}
                  </h2>
                  <div style="font-size: 18px; color: #ff7023; font-weight: 500; margin-bottom: 16px;">
                    {service.headline}
                  </div>
                  <p style="font-size: 16px; color: rgba(255,255,255,0.8); line-height: 1.7;">
                    {service.fullDescription}
                  </p>
                </div>

                <!-- Business Problem Callout -->
                <div style="background: #110e0e; border-left: 3px solid #ff4444; border-radius: 12px; padding: 20px 24px;">
                  <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: #ff4444; text-transform: uppercase; margin-bottom: 6px;">
                    The Business Problem
                  </div>
                  <p style="font-size: 14px; color: rgba(255,255,255,0.85); line-height: 1.6; margin: 0;">
                    {service.businessProblem}
                  </p>
                </div>

                <!-- Proposed AI Solution Callout -->
                <div style="background: #0e120f; border-left: 3px solid #00c853; border-radius: 12px; padding: 20px 24px;">
                  <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: #00c853; text-transform: uppercase; margin-bottom: 6px;">
                    Proposed AI Solution
                  </div>
                  <p style="font-size: 14px; color: rgba(255,255,255,0.85); line-height: 1.6; margin: 0;">
                    {service.proposedSolution}
                  </p>
                </div>

                <!-- Example Workflow Visualization Box -->
                <div style="background: #141414; border: 1px dashed #2a2a2a; border-radius: 12px; padding: 20px 24px;">
                  <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: rgba(255,255,255,0.5); text-transform: uppercase; margin-bottom: 8px;">
                    Typical Example Workflow
                  </div>
                  <div style="font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: #ffffff; line-height: 1.7;">
                    {service.exampleWorkflow}
                  </div>
                </div>

                <div style="font-size: 13px; color: rgba(255,255,255,0.6);">
                  <strong style="color: #ffffff;">Ideal For:</strong> {service.idealClients}
                </div>

                <!-- CTAs -->
                <div style="display: flex; gap: 16px; margin-top: 10px; flex-wrap: wrap;">
                  <a href={`/contact-us?service=${service.id}`} class="common-button w-button" style="padding: 14px 32px; border-radius: 100px;">
                    {service.primaryCta} ↗
                  </a>
                  <a href="/pricing" class="common-button outline-button w-button" style="padding: 14px 28px; border-radius: 100px; border-color: rgba(255,255,255,0.2);">
                    Indicative: {service.indicativePricing}
                  </a>
                </div>
              </div>

              <!-- Right Column: Services Included & Deliverables -->
              <div style="background: #111111; border: 1px solid #222222; border-radius: 20px; padding: 32px; display: flex; flex-direction: column; gap: 28px;">
                
                <div>
                  <h4 style="font-size: 16px; font-weight: 700; color: #ffffff; text-transform: uppercase; font-family: 'IBM Plex Mono', monospace; margin-bottom: 16px; letter-spacing: 1px;">
                    Services Included:
                  </h4>
                  <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; font-size: 14px; color: rgba(255,255,255,0.85);">
                    {service.servicesIncluded.map((s) => (
                      <li style="display: flex; align-items: flex-start; gap: 10px;">
                        <span style="color: #ff7023; font-weight: bold;">•</span>
                        <span>{s}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div style="border-top: 1px solid #1f1f1f; padding-top: 24px;">
                  <h4 style="font-size: 16px; font-weight: 700; color: #ffffff; text-transform: uppercase; font-family: 'IBM Plex Mono', monospace; margin-bottom: 16px; letter-spacing: 1px;">
                    Tangible Deliverables:
                  </h4>
                  <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; font-size: 13px; color: rgba(255,255,255,0.75);">
                    {service.deliverables.map((d) => (
                      <li style="display: flex; align-items: flex-start; gap: 10px;">
                        <span style="color: #00c853;">✓</span>
                        <span>{d}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div style="border-top: 1px solid #1f1f1f; padding-top: 20px;">
                  <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 10px;">
                    Technology Stack
                  </div>
                  <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                    {service.technology.map((t) => (
                      <span style="background: #1a1a1a; border: 1px solid #282828; color: #ff7023; font-family: 'IBM Plex Mono', monospace; font-size: 12px; padding: 4px 10px; border-radius: 6px;">
                        {t}
                      </span>
                    ))}
                  </div>
                </div>

              </div>

            </div>
          </article>
        );
      })}

    </div>
  </section>

  <!-- SECTION E: HOW THE ENGAGEMENT WORKS (4-STAGE PROCESS) -->
  <section class="section" style="background-color: #000000; padding-top: 100px; padding-bottom: 100px; border-top: 1px solid #1a1a1a;">
    <div class="w-layout-blockcontainer container w-container">
      
      <div class="common-heading-div" style="text-align: center; max-width: 800px; margin-left: auto; margin-right: auto; margin-bottom: 60px;">
        <div class="small-paragraph" style="color: #ff7023; font-family: 'IBM Plex Mono', monospace; letter-spacing: 2px;">ENGAGEMENT METHODOLOGY</div>
        <h2 class="h2-heading" style="margin-top: 12px;">How We Build &amp; Deploy for You</h2>
        <p class="large-paragraph" style="color: rgba(255,255,255,0.7); margin-top: 16px;">
          A disciplined, predictable 4-stage delivery process from initial discovery to live production and staff handover.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px;">
        {engagementProcess.map((stage) => (
          <div style="background: #0a0a0a; border: 1px solid #1f1f1f; border-radius: 20px; padding: 32px 26px; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #1a1a1a; padding-bottom: 16px; margin-bottom: 20px;">
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: 28px; font-weight: 800; color: #ff7023;">
                  {stage.step}
                </span>
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; background: #161616; padding: 4px 10px; border-radius: 100px; color: rgba(255,255,255,0.6);">
                  {stage.duration}
                </span>
              </div>
              <h3 style="font-size: 20px; font-weight: 700; color: #ffffff; margin-bottom: 12px;">
                {stage.title}
              </h3>
              <p style="font-size: 14px; color: rgba(255,255,255,0.7); line-height: 1.6; margin-bottom: 20px;">
                {stage.description}
              </p>
            </div>

            <div style="border-top: 1px solid #181818; padding-top: 16px;">
              <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: rgba(255,255,255,0.4); text-transform: uppercase; margin-bottom: 8px;">
                Outputs
              </div>
              <ul style="list-style: none; padding: 0; margin: 0; font-size: 12px; color: rgba(255,255,255,0.8); line-height: 1.8;">
                {stage.deliverables.map((d) => (
                  <li>• {d}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- SECTION F: INTENDED BUSINESS OUTCOMES -->
  <section class="section" style="background-color: #080808; padding-top: 100px; padding-bottom: 100px; border-top: 1px solid #1a1a1a;">
    <div class="w-layout-blockcontainer container w-container">
      
      <div class="common-heading-div" style="text-align: center; max-width: 800px; margin-left: auto; margin-right: auto; margin-bottom: 60px;">
        <div class="small-paragraph" style="color: #ff7023; font-family: 'IBM Plex Mono', monospace; letter-spacing: 2px;">BUSINESS IMPACT</div>
        <h2 class="h2-heading" style="margin-top: 12px;">Outcomes Our Systems Are Designed to Support</h2>
        <p class="large-paragraph" style="color: rgba(255,255,255,0.7); margin-top: 16px;">
          Practical operational gains measured against your real business KPIs, not hypothetical marketing hype.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
        {intendedOutcomes.map((outcome) => (
          <div style="background: #0f0f0f; border: 1px solid #1c1c1c; border-radius: 16px; padding: 28px 24px; display: flex; gap: 16px; align-items: flex-start;">
            <div style="font-size: 28px; line-height: 1; flex-shrink: 0;">
              {outcome.icon}
            </div>
            <div>
              <h3 style="font-size: 17px; font-weight: 700; color: #ffffff; margin-bottom: 8px;">
                {outcome.title}
              </h3>
              <p style="font-size: 14px; color: rgba(255,255,255,0.65); line-height: 1.6; margin: 0;">
                {outcome.description}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- SECTION G: TECHNOLOGY & INTEGRATIONS -->
  <section class="section" style="background-color: #000000; padding-top: 100px; padding-bottom: 100px; border-top: 1px solid #1a1a1a;">
    <div class="w-layout-blockcontainer container w-container">
      
      <div class="common-heading-div" style="text-align: center; max-width: 800px; margin-left: auto; margin-right: auto; margin-bottom: 60px;">
        <div class="small-paragraph" style="color: #ff7023; font-family: 'IBM Plex Mono', monospace; letter-spacing: 2px;">TECH ECOSYSTEM</div>
        <h2 class="h2-heading" style="margin-top: 12px;">Platforms &amp; Tools We Support</h2>
        <p class="large-paragraph" style="color: rgba(255,255,255,0.7); margin-top: 16px;">
          We build on stable, enterprise-grade foundations that your engineering and ops teams can maintain and extend.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
        {techEcosystem.map((cat) => (
          <div style="background: #0c0c0c; border: 1px solid #1f1f1f; border-radius: 16px; padding: 24px 28px;">
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: #ff7023; text-transform: uppercase; margin-bottom: 14px; font-weight: 600;">
              {cat.category}
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 8px;">
              {cat.tools.map((t) => (
                <span style="background: #161616; border: 1px solid #262626; color: #e0e0e0; font-size: 13px; padding: 6px 12px; border-radius: 6px;">
                  {t}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- SECTION H: INDICATIVE PRICING & INVESTMENT RANGES -->
  <section class="section" style="background-color: #080808; padding-top: 100px; padding-bottom: 100px; border-top: 1px solid #1a1a1a;">
    <div class="w-layout-blockcontainer container w-container">
      
      <div class="common-heading-div" style="text-align: center; max-width: 800px; margin-left: auto; margin-right: auto; margin-bottom: 50px;">
        <div class="small-paragraph" style="color: #ff7023; font-family: 'IBM Plex Mono', monospace; letter-spacing: 2px;">INVESTMENT GUIDELINES</div>
        <h2 class="h2-heading" style="margin-top: 12px;">Indicative Project Ranges</h2>
        <p class="large-paragraph" style="color: rgba(255,255,255,0.7); margin-top: 16px;">
          Transparent starting estimates. Final quotations depend on integration complexity, data readiness, testing scope, and deployment requirements.
        </p>
      </div>

      <div style="max-w: 900px; margin: 0 auto; background: #0c0c0c; border: 1px solid #1f1f1f; border-radius: 20px; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 15px;">
          <thead>
            <tr style="border-bottom: 1px solid #222; background: #111;">
              <th style="padding: 18px 24px; color: #ff7023; font-family: 'IBM Plex Mono', monospace; font-size: 12px; text-transform: uppercase;">Service Focus</th>
              <th style="padding: 18px 24px; color: #ffffff; font-family: 'IBM Plex Mono', monospace; font-size: 12px; text-transform: uppercase;">Indicative Initial Range</th>
              <th style="padding: 18px 24px; color: rgba(255,255,255,0.6); font-family: 'IBM Plex Mono', monospace; font-size: 12px; text-transform: uppercase;">Typical Timeline</th>
            </tr>
          </thead>
          <tbody style="color: rgba(255,255,255,0.85);">
