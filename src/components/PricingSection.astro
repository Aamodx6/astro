---
import { pricingPlans } from '../data/site';

interface Props {
  isPageHero?: boolean;
}

const { isPageHero = false } = Astro.props;
---

<section id="pricing" class="py-24 sm:py-32 bg-neutral-950 text-white relative border-b border-neutral-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 pb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-neutral-900 border border-neutral-800 text-xs font-mono font-medium text-indigo-400">
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
        <span>Transparent Engagement Models</span>
      </div>
      {isPageHero ? (
        <h1 class="display-section font-display font-bold tracking-tight text-white">
          Predictable investment. <br />
          Uncompromising velocity.
        </h1>
      ) : (
        <h2 class="display-section font-display font-bold tracking-tight text-white">
          Predictable investment. <br />
          Uncompromising velocity.
        </h2>
      )}
      <p class="text-neutral-400 text-lg leading-relaxed">
        Choose between sprint-based product validation, dedicated monthly studio partnerships, or custom enterprise architecture. No hidden fees or bloated overhead.
      </p>

      <!-- Monthly / Annual Switcher -->
      <div class="pt-6 flex items-center justify-center gap-4">
        <span id="label-monthly" class="text-sm font-medium text-white transition-colors">Monthly Billing</span>
        
        <button
          id="billing-toggle"
          type="button"
          role="switch"
          aria-checked="false"
          aria-label="Toggle between monthly and annual billing"
          class="relative inline-flex h-7 w-14 shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-neutral-800 transition-colors duration-200 ease-in-out focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:outline-none"
        >
          <span
            id="toggle-thumb"
            class="pointer-events-none inline-block h-6 w-6 transform rounded-full bg-white shadow-lg ring-0 transition duration-200 ease-in-out translate-x-0"
          ></span>
        </button>

        <div class="flex items-center gap-1.5">
          <span id="label-annual" class="text-sm font-medium text-neutral-400 transition-colors">Annual Agreement</span>
          <span class="px-2 py-0.5 rounded-full bg-indigo-500/20 border border-indigo-500/40 text-[11px] font-mono font-semibold text-indigo-300">
            Save 20%
          </span>
        </div>
      </div>

    </div>

    <!-- Pricing Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 pt-6 items-stretch">
      {pricingPlans.map((plan) => (
        <div
          class={`relative rounded-3xl p-8 sm:p-10 flex flex-col justify-between transition-all duration-300 ${
            plan.popular
              ? 'bg-neutral-900 border-2 border-indigo-500 shadow-2xl shadow-indigo-500/10'
              : 'bg-neutral-900/60 border border-neutral-800 hover:border-neutral-700'
          }`}
        >
          {plan.popular && (
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-3.5 py-1 rounded-full bg-indigo-600 text-white font-mono text-[11px] font-bold uppercase tracking-wider shadow-md">
              Most Popular Partnership
            </div>
          )}

          <div>
            <!-- Badge & Name -->
            <div class="flex items-center justify-between">
              <h3 class="font-display font-bold text-2xl text-white">
                {plan.name}
              </h3>
              {plan.badge && !plan.popular && (
                <span class="text-[11px] font-mono text-neutral-400 px-2 py-0.5 rounded bg-neutral-800">
                  {plan.badge}
                </span>
              )}
            </div>

            <p class="text-neutral-400 text-sm mt-3 leading-relaxed">
              {plan.description}
            </p>

            <!-- Dynamic Price -->
            <div class="pt-6 pb-6 border-b border-neutral-800">
              <div class="flex items-baseline gap-2">
                <span class="text-xs text-neutral-500 font-mono">$</span>
                <span
                  class="price-display text-4xl sm:text-5xl font-display font-extrabold text-white tracking-tight"
                  data-monthly={plan.monthlyPrice}
                  data-annual={plan.annualPrice}
                >
                  {plan.monthlyPrice.toLocaleString()}
                </span>
                <span class="billing-period text-xs font-mono text-neutral-400">/month</span>
              </div>
              <div class="annual-note text-[11px] font-mono text-indigo-400 mt-1 hidden">
                Billed annually (save ${( (plan.monthlyPrice - plan.annualPrice) * 12 ).toLocaleString()}/yr)
              </div>
              <div class="text-xs font-mono text-neutral-500 mt-2">
                Timeline: <span class="text-neutral-300">{plan.timeline}</span>
              </div>
            </div>

            <!-- Deliverables List -->
            <div class="pt-6 space-y-3">
              <div class="text-xs font-mono uppercase tracking-wider text-neutral-400 font-semibold">
                Included Deliverables:
              </div>
              <ul class="space-y-2.5 text-sm text-neutral-300">
                {plan.deliverables.map((item) => (
                  <li class="flex items-start gap-2.5">
                    <svg class="w-4 h-4 text-indigo-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span class="text-xs leading-relaxed">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Card Bottom Action -->
          <div class="pt-8 mt-8 border-t border-neutral-800/80">
            <a
              href={`/contact-us?plan=${plan.id}`}
              class={`w-full py-3.5 text-center text-sm font-semibold rounded-xl transition-all duration-200 block ${
                plan.popular
                  ? 'bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-600/30'
                  : 'bg-neutral-800 hover:bg-neutral-700 text-white'
              }`}
            >
              Select {plan.name}
            </a>
            <p class="text-center text-[11px] font-mono text-neutral-500 mt-2.5">
              Ideal for: {plan.idealFor}
            </p>
          </div>

        </div>
      ))}
    </div>

    <!-- Need custom consultation? -->
    <div class="mt-16 text-center">
      <div class="inline-flex flex-col sm:flex-row items-center gap-3 p-4 rounded-2xl bg-neutral-900 border border-neutral-800 text-sm">
        <span class="text-neutral-300 font-medium">Need a bespoke multi-month engagement or advisory seat?</span>
        <a href="/contact-us?type=custom" class="text-indigo-400 hover:text-indigo-300 font-semibold hover:underline inline-flex items-center gap-1">
          <span>Schedule Scoping Call</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>

  </div>
</section>

<script is:inline>
  const toggle = document.getElementById('billing-toggle');
  const thumb = document.getElementById('toggle-thumb');
  const labelMonthly = document.getElementById('label-monthly');
  const labelAnnual = document.getElementById('label-annual');
  const priceDisplays = document.querySelectorAll('.price-display');
  const annualNotes = document.querySelectorAll('.annual-note');

  let isAnnual = false;

  if (toggle) {
    toggle.addEventListener('click', () => {
      isAnnual = !isAnnual;
      toggle.setAttribute('aria-checked', String(isAnnual));

      if (isAnnual) {
        thumb.classList.remove('translate-x-0');
        thumb.classList.add('translate-x-7');
        toggle.classList.remove('bg-neutral-800');
        toggle.classList.add('bg-indigo-600');
        labelAnnual.classList.remove('text-neutral-400');
        labelAnnual.classList.add('text-white');
        labelMonthly.classList.remove('text-white');
        labelMonthly.classList.add('text-neutral-400');

        priceDisplays.forEach(el => {
          const val = Number(el.getAttribute('data-annual'));
          el.textContent = val.toLocaleString();
        });
        annualNotes.forEach(el => el.classList.remove('hidden'));
      } else {
        thumb.classList.add('translate-x-0');
        thumb.classList.remove('translate-x-7');
        toggle.classList.add('bg-neutral-800');
        toggle.classList.remove('bg-indigo-600');
        labelMonthly.classList.add('text-white');
        labelMonthly.classList.remove('text-neutral-400');
        labelAnnual.classList.add('text-neutral-400');
        labelAnnual.classList.remove('text-white');

        priceDisplays.forEach(el => {
          const val = Number(el.getAttribute('data-monthly'));
          el.textContent = val.toLocaleString();
        });
        annualNotes.forEach(el => el.classList.add('hidden'));
      }
    });
  }
</script>
