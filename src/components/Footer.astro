---
import { siteConfig } from '../data/site';

const currentYear = new Date().getFullYear();
---

<footer class="bg-neutral-950 text-neutral-300 pt-20 pb-12 border-t border-neutral-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 pb-16 border-b border-neutral-800/80">
      
      <!-- Brand & Positioning Column -->
      <div class="lg:col-span-2 space-y-5">
        <a href="/" class="flex items-center gap-3 group" aria-label="Soale Astra Home">
          <div class="w-9 h-9 rounded-xl bg-white flex items-center justify-center text-neutral-950 font-mono font-bold text-base shadow-sm group-hover:bg-indigo-400 transition-colors">
            <svg class="w-5 h-5 text-neutral-950" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <span class="font-display font-bold text-xl tracking-tight text-white">
            Soale Astra
          </span>
        </a>

        <p class="text-neutral-400 text-sm leading-relaxed max-w-sm">
          An independent digital product and AI interface design studio. We partner with visionary founders and software engineering teams to turn complex models into lovable products.
        </p>

        <div class="flex items-center gap-2 pt-2">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-neutral-900 border border-neutral-800 text-xs font-mono text-neutral-300">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Booking Q1/Q2 Sprints
          </span>
        </div>

        <div class="pt-2 text-xs font-mono text-neutral-500">
          San Francisco &amp; Distributed Worldwide
        </div>
      </div>

      <!-- Navigation Column: Selected Work -->
      <div class="space-y-4">
        <h3 class="text-xs font-mono uppercase tracking-wider text-neutral-400 font-semibold">
          Selected Work
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/work/neuroniq-ai-powered-hiring-assistant" class="text-neutral-400 hover:text-white transition-colors">
              NeuronIQ AI
            </a>
          </li>
          <li>
            <a href="/work/echo-ai-analytics-platform-design" class="text-neutral-400 hover:text-white transition-colors">
              Echo Analytics
            </a>
          </li>
          <li>
            <a href="/work/orbitpay-banking-and-fintech-app" class="text-neutral-400 hover:text-white transition-colors">
              OrbitPay Mobile
            </a>
          </li>
          <li>
            <a href="/work/nanobot--ai-chat-experience" class="text-neutral-400 hover:text-white transition-colors">
              Nanobot Chat
            </a>
          </li>
          <li>
            <a href="/work" class="inline-flex items-center gap-1.5 text-indigo-400 hover:text-indigo-300 font-medium text-xs pt-1">
              <span>View All 9 Case Studies</span>
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <!-- Navigation Column: Studio -->
      <div class="space-y-4">
        <h3 class="text-xs font-mono uppercase tracking-wider text-neutral-400 font-semibold">
          Studio
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/about-us" class="text-neutral-400 hover:text-white transition-colors">About Us</a>
          </li>
          <li>
            <a href="/services" class="text-neutral-400 hover:text-white transition-colors">Services &amp; Capabilities</a>
          </li>
          <li>
            <a href="/services-detail" class="text-neutral-400 hover:text-white transition-colors">Deep Service Breakdown</a>
          </li>
          <li>
            <a href="/pricing" class="text-neutral-400 hover:text-white transition-colors">Pricing &amp; Engagement</a>
          </li>
          <li>
            <a href="/blog" class="text-neutral-400 hover:text-white transition-colors">Insights &amp; Publications</a>
          </li>
          <li>
            <a href="/contact-us" class="text-neutral-400 hover:text-white transition-colors">Contact &amp; Scoping</a>
          </li>
        </ul>
      </div>

      <!-- Navigation Column: System & Specs -->
      <div class="space-y-4">
        <h3 class="text-xs font-mono uppercase tracking-wider text-neutral-400 font-semibold">
          Standards
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/templates/styleguide" class="text-neutral-400 hover:text-white transition-colors">Design System &amp; Tokens</a>
          </li>
          <li>
            <a href="/templates/changelog" class="text-neutral-400 hover:text-white transition-colors">Studio Changelog</a>
          </li>
          <li>
            <a href="/templates/license" class="text-neutral-400 hover:text-white transition-colors">IP &amp; Licensing Terms</a>
          </li>
          <li>
            <a href="/rss.xml" class="text-neutral-400 hover:text-white transition-colors">RSS Feed</a>
          </li>
          <li>
            <a href="/sitemap-index.xml" class="text-neutral-400 hover:text-white transition-colors">Sitemap XML</a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500 font-mono">
      <div>
        &copy; {currentYear} Soale Astra Studio LLC. All rights reserved. Built with precision &amp; zero template bloat.
      </div>

      <div class="flex items-center gap-6">
        {siteConfig.socialLinks.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-neutral-300 transition-colors"
          >
            {s.platform}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
