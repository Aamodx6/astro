---
import { siteConfig } from '../data/site';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { label: 'Work', href: '/work' },
  { label: 'Services', href: '/services' },
  { label: 'Process', href: '/#process' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Insights', href: '/blog' },
  { label: 'About', href: '/about-us' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  if (href.startsWith('/#')) return false;
  return currentPath.startsWith(href);
};
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/80 backdrop-blur-md border-b border-neutral-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Studio Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus-visible:ring-2 focus-visible:ring-indigo-600 rounded-lg p-1" aria-label="Soale Astra Home">
        <div class="w-9 h-9 rounded-xl bg-neutral-950 flex items-center justify-center text-white font-mono font-bold text-base shadow-sm group-hover:scale-105 transition-transform duration-200">
          <svg class="w-5 h-5 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-display font-bold text-lg tracking-tight text-neutral-900 group-hover:text-indigo-600 transition-colors">
            Soale Astra
          </span>
          <span class="text-[10px] font-mono uppercase tracking-wider text-neutral-500 -mt-1 font-medium">
            Studio
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Main Navigation">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`px-3.5 py-2 text-sm font-medium rounded-lg transition-all duration-150 ${
              isActive(item.href)
                ? 'text-indigo-600 bg-indigo-50/80 font-semibold'
                : 'text-neutral-600 hover:text-neutral-950 hover:bg-neutral-100/70'
            }`}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Desktop Right CTA -->
      <div class="hidden md:flex items-center gap-4">
        <div class="flex items-center gap-2 px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-200/80 text-[11px] font-mono text-emerald-800">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Q1 Sprints Open</span>
        </div>

        <a
          href="/contact-us"
          class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium text-white bg-neutral-950 rounded-xl hover:bg-indigo-600 transition-all duration-200 shadow-sm hover:shadow-indigo-500/20 active:scale-95"
        >
          <span>Initiate Project</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center gap-3 md:hidden">
        <a
          href="/contact-us"
          class="px-3 py-1.5 text-xs font-semibold text-white bg-neutral-950 rounded-lg hover:bg-indigo-600 transition-colors"
        >
          Contact
        </a>
        <button
          id="mobile-menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Toggle navigation menu"
          class="p-2 text-neutral-700 hover:text-neutral-950 hover:bg-neutral-100 rounded-lg focus-visible:ring-2 focus-visible:ring-indigo-600"
        >
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-nav"
    class="md:hidden hidden border-b border-neutral-200 bg-white/95 backdrop-blur-lg px-4 pt-3 pb-6 transition-all duration-200"
  >
    <div class="flex flex-col gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`px-4 py-2.5 text-base font-medium rounded-lg ${
            isActive(item.href)
              ? 'text-indigo-600 bg-indigo-50 font-semibold'
              : 'text-neutral-700 hover:bg-neutral-100'
          }`}
        >
          {item.label}
        </a>
      ))}
      <div class="mt-4 pt-4 border-t border-neutral-200 flex flex-col gap-3">
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-emerald-50 border border-emerald-200 text-xs font-mono text-emerald-800">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Sprint availability: Active Q1/Q2</span>
        </div>
        <a
          href="/contact-us"
          class="w-full text-center py-3 text-sm font-semibold text-white bg-neutral-950 rounded-xl hover:bg-indigo-600 transition-colors shadow-sm"
        >
          Initiate a Project
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileNav = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (menuBtn && mobileNav) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileNav.classList.toggle('hidden');
      if (iconOpen && iconClose) {
        iconOpen.classList.toggle('hidden');
        iconClose.classList.toggle('hidden');
      }
    });

    // Close on mobile link click
    mobileNav.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileNav.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
        if (iconOpen && iconClose) {
          iconOpen.classList.remove('hidden');
          iconClose.classList.add('hidden');
        }
      });
    });
  }
</script>
