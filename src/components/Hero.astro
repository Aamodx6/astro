---
import { clientLogos } from '../data/site';
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden bg-neutral-950 text-white">
  <!-- Subtle ambient glow & grid -->
  <div class="absolute inset-0 dark-grid-backdrop opacity-30 pointer-events-none"></div>
  <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-gradient-to-b from-indigo-600/20 via-purple-600/10 to-transparent blur-3xl pointer-events-none rounded-full"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Top Positioning Pill -->
    <div class="flex items-center justify-center md:justify-start">
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-neutral-900/90 border border-neutral-800 text-xs font-mono text-neutral-300 shadow-sm backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
        <span class="text-neutral-400">Positioning:</span>
        <span class="text-white font-medium">AI Interface &amp; Digital Product Studio</span>
      </div>
    </div>

    <!-- Main Editorial Headline & Subhead -->
    <div class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <div class="lg:col-span-7 space-y-8 text-center md:text-left">
        <h1 class="display-hero font-display font-extrabold text-white tracking-tight">
          Designing what <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-300 via-indigo-100 to-cyan-200">
            AI makes possible.
          </span>
        </h1>

        <p class="display-subhead text-neutral-400 max-w-2xl font-normal leading-relaxed">
          From complex models to digital products people love. We partner with ambitious founders, AI startups, and engineering teams to transform breakthrough technology into category-defining software.
        </p>

        <!-- CTA Buttons Group -->
        <div class="flex flex-col sm:flex-row items-center justify-center md:justify-start gap-4 pt-2">
          <a
            href="/contact-us"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-7 py-4 text-base font-semibold text-neutral-950 bg-white rounded-xl hover:bg-neutral-100 hover:shadow-xl hover:shadow-white/10 transition-all duration-200 active:scale-98 group"
          >
            <span>Initiate a Project</span>
            <svg class="w-4 h-4 text-neutral-950 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>

          <a
            href="/work"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-4 text-base font-medium text-neutral-300 bg-neutral-900/80 hover:bg-neutral-800 border border-neutral-800 rounded-xl hover:text-white transition-all duration-200"
          >
            <span>Selected Work (9)</span>
            <svg class="w-4 h-4 text-neutral-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </a>
        </div>

        <!-- Verified Studio Milestones -->
        <div class="pt-8 border-t border-neutral-800/80 grid grid-cols-3 gap-6 text-left">
          <div>
            <div class="text-2xl sm:text-3xl font-display font-bold text-white tracking-tight">8+</div>
            <div class="text-xs font-mono text-neutral-500 uppercase tracking-wider mt-0.5">Years Crafting</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-display font-bold text-white tracking-tight">150+</div>
            <div class="text-xs font-mono text-neutral-500 uppercase tracking-wider mt-0.5">Shipped Releases</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-display font-bold text-white tracking-tight">100%</div>
            <div class="text-xs font-mono text-neutral-500 uppercase tracking-wider mt-0.5">Bespoke Design</div>
          </div>
        </div>

      </div>

      <!-- Hero Visual: Custom Interactive Computational Canvas Mockup -->
      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-lg lg:max-w-none rounded-2xl bg-neutral-900/90 border border-neutral-800 p-4 sm:p-5 shadow-2xl backdrop-blur-xl">
          
          <!-- Mock Window Header -->
          <div class="flex items-center justify-between pb-4 border-b border-neutral-800 text-xs font-mono text-neutral-400">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
              <span class="ml-2 text-neutral-400 text-[11px]">astra-agent-orchestrator.ts</span>
            </div>
            <div class="flex items-center gap-1.5 px-2 py-0.5 rounded bg-neutral-800 text-[10px] text-emerald-400">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
              <span>LIVE CLUSTER</span>
            </div>
          </div>

          <!-- Active Multi-Agent Topology Visualizer -->
          <div class="py-4 space-y-3.5">
            
            <div class="p-3 rounded-xl bg-neutral-950/80 border border-neutral-800/80 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-indigo-400 font-mono text-xs">
                  01
                </div>
                <div>
                  <div class="text-xs font-semibold text-white">Synthesizer Agent</div>
                  <div class="text-[11px] font-mono text-neutral-500">Vector Embeddings &amp; Context</div>
                </div>
              </div>
              <span class="px-2 py-0.5 text-[10px] font-mono rounded bg-indigo-950 text-indigo-300 border border-indigo-800/50">
                Active: 240 tok/s
              </span>
            </div>

            <div class="p-3 rounded-xl bg-neutral-950/80 border border-neutral-800/80 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 font-mono text-xs">
                  02
                </div>
                <div>
                  <div class="text-xs font-semibold text-white">Interface Dispatcher</div>
                  <div class="text-[11px] font-mono text-neutral-500">Generative UI Canvas Render</div>
                </div>
              </div>
              <span class="px-2 py-0.5 text-[10px] font-mono rounded bg-cyan-950 text-cyan-300 border border-cyan-800/50">
                12ms latency
              </span>
            </div>

            <div class="p-3 rounded-xl bg-neutral-950/80 border border-neutral-800/80 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 font-mono text-xs">
                  03
                </div>
                <div>
                  <div class="text-xs font-semibold text-white">Human-In-The-Loop Guard</div>
                  <div class="text-[11px] font-mono text-neutral-500">Confidence Threshold: 99.4%</div>
                </div>
              </div>
              <span class="px-2 py-0.5 text-[10px] font-mono rounded bg-emerald-950 text-emerald-300 border border-emerald-800/50">
                Verified
              </span>
            </div>

            <!-- Streaming Mock Terminal Output -->
            <div class="mt-4 p-3 rounded-xl bg-black/60 border border-neutral-800 font-mono text-[11px] space-y-1.5">
              <div class="text-neutral-500">// Real-time studio architectural output</div>
              <div class="text-indigo-400">$ soale deploy --ux-system=agentic-v3</div>
              <div class="text-neutral-300 flex items-center gap-2">
                <span class="text-emerald-400">✓</span>
                <span>Optimized token streaming ergonomics</span>
              </div>
              <div class="text-neutral-300 flex items-center gap-2">
                <span class="text-emerald-400">✓</span>
                <span>Zero latency visual jitter | Accessible WCAG 2.2 AA</span>
              </div>
            </div>

          </div>

          <!-- Bottom Visual Annotation -->
          <div class="pt-3 border-t border-neutral-800/80 flex items-center justify-between text-[11px] font-mono text-neutral-500">
            <span>Built by Soale Astra</span>
            <span class="text-neutral-400">Figma ↔ Production Tokenized</span>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>
