---
import { testimonialsData } from '../data/site';
---

<section class="py-24 sm:py-32 bg-white text-neutral-900 border-b border-neutral-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl space-y-4 pb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200/80 text-xs font-mono font-medium text-emerald-800">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
        <span>Client Outcomes &amp; Peer Reviews</span>
      </div>
      <h2 class="display-section font-display font-bold tracking-tight text-neutral-950">
        Trusted by engineers, <br />
        revered by founders.
      </h2>
      <p class="text-neutral-600 text-lg leading-relaxed">
        Here is what product leaders and founders say about collaborating with Soale Astra on high-stakes releases.
      </p>
    </div>

    <!-- Editorial Testimonials 2x2 Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {testimonialsData.map((item) => (
        <figure class="relative rounded-2xl bg-neutral-50 border border-neutral-200 p-8 sm:p-10 flex flex-col justify-between hover:border-neutral-300 hover:shadow-lg transition-all">
          
          <div class="space-y-6">
            <!-- Metric Pill -->
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 border border-indigo-200/60 text-xs font-mono font-semibold text-indigo-700">
              <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
              <span>{item.metric}</span>
            </div>

            <blockquote class="text-neutral-800 text-base sm:text-lg leading-relaxed font-normal">
              &ldquo;{item.quote}&rdquo;
            </blockquote>
          </div>

          <!-- Author Attribution -->
          <figcaption class="pt-6 mt-8 border-t border-neutral-200 flex items-center gap-4">
            <img
              src={item.avatar}
              alt={item.author}
              class="w-12 h-12 rounded-full object-cover bg-neutral-200 border border-neutral-300"
              loading="lazy"
              width="48"
              height="48"
            />
            <div>
              <div class="font-display font-bold text-neutral-950 text-base">
                {item.author}
              </div>
              <div class="text-xs text-neutral-500 font-medium">
                {item.role} • <span class="text-neutral-700 font-semibold">{item.company}</span>
              </div>
            </div>
          </figcaption>

        </figure>
      ))}
    </div>

  </div>
</section>
