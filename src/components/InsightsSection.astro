---
import blogData from '../data/blog.json';

const recentPosts = blogData.slice(0, 3);
---

<section class="py-24 sm:py-32 bg-white text-neutral-900 border-b border-neutral-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-16 border-b border-neutral-200">
      <div class="space-y-4 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 border border-indigo-200/80 text-xs font-mono font-medium text-indigo-700">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-600"></span>
          <span>Studio Insights &amp; Research</span>
        </div>
        <h2 class="display-section font-display font-bold tracking-tight text-neutral-950">
          Thought leadership from <br />
          the frontlines of AI design.
        </h2>
      </div>

      <div>
        <a
          href="/blog"
          class="inline-flex items-center gap-2 px-5 py-3 text-sm font-semibold text-neutral-900 bg-white border border-neutral-300 rounded-xl hover:bg-neutral-100 hover:border-neutral-400 transition-all shadow-sm"
        >
          <span>View All 13 Articles</span>
          <svg class="w-4 h-4 text-neutral-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Editorial 3-Column Articles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 pt-16">
      {recentPosts.map((post) => (
        <article class="group flex flex-col justify-between rounded-2xl bg-neutral-50 border border-neutral-200/80 p-6 hover:bg-white hover:border-neutral-300 hover:shadow-xl transition-all duration-300">
          
          <div class="space-y-4">
            <!-- Article Image Thumbnail -->
            <a href={`/blog/${post.slug}`} class="block overflow-hidden rounded-xl bg-neutral-200 aspect-[16/10] relative">
              <img
                src={post.image}
                alt={post.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </a>

            <!-- Metadata Row -->
            <div class="flex items-center justify-between font-mono text-xs text-neutral-500 pt-1">
              <span class="px-2.5 py-0.5 rounded bg-neutral-100 border border-neutral-200/60 text-neutral-700 font-medium">
                {post.category}
              </span>
              <span>{post.readTime}</span>
            </div>

            <!-- Title -->
            <h3 class="font-display font-bold text-lg sm:text-xl text-neutral-950 group-hover:text-indigo-600 transition-colors leading-snug">
              <a href={`/blog/${post.slug}`}>
                {post.title}
              </a>
            </h3>

            <!-- Description -->
            <p class="text-neutral-600 text-sm leading-relaxed line-clamp-3">
              {post.description}
            </p>
          </div>

          <!-- Footer / Link -->
          <div class="pt-6 mt-6 border-t border-neutral-200/60 flex items-center justify-between text-xs font-mono text-neutral-500">
            <span>{post.date}</span>
            <a href={`/blog/${post.slug}`} class="text-indigo-600 font-semibold group-hover:underline inline-flex items-center gap-1">
              <span>Read Article</span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
          </div>

        </article>
      ))}
    </div>

  </div>
</section>
