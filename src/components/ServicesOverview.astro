---
import { servicesData } from '../data/site';
---

<section id="services" class="py-24 sm:py-32 bg-white text-neutral-900 border-b border-neutral-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl space-y-4 pb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-50 border border-cyan-200/80 text-xs font-mono font-medium text-cyan-800">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-600"></span>
        <span>Capabilities &amp; Outcomes</span>
      </div>
      <h2 class="display-section font-display font-bold tracking-tight text-neutral-950">
        Engineered for clarity. <br />
        Designed for scale.
      </h2>
      <p class="text-neutral-600 text-lg leading-relaxed">
        We bridge the gap between deep technical capability and human perception. Our multidisciplinary practice solves high-friction interaction problems across the entire product lifecycle.
      </p>
    </div>

    <!-- 6 Core Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {servicesData.map((service, index) => (
        <div class="group relative rounded-2xl bg-neutral-50 border border-neutral-200/90 p-8 hover:bg-white hover:border-indigo-300 hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
          
          <div class="space-y-5">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-semibold text-indigo-600 bg-indigo-50 border border-indigo-200/60 px-2.5 py-1 rounded-md">
                0{index + 1}
              </span>
              <span class="text-[11px] font-mono text-neutral-500">
                {service.metrics}
              </span>
            </div>

            <h3 class="font-display font-bold text-xl text-neutral-950 group-hover:text-indigo-600 transition-colors">
              {service.title}
            </h3>

            <p class="text-neutral-600 text-sm leading-relaxed">
              {service.description}
            </p>

            <!-- Deliverables -->
            <div class="pt-2 border-t border-neutral-200/60 space-y-2">
              <div class="text-[11px] font-mono uppercase text-neutral-400 tracking-wider">What We Ship</div>
              <ul class="space-y-1.5 text-xs text-neutral-700">
                {service.deliverables.slice(0, 3).map((item) => (
                  <li class="flex items-start gap-2">
                    <span class="text-indigo-500 font-bold">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="pt-6 mt-6 border-t border-neutral-200/60 flex items-center justify-between">
            <a
              href="/services"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-neutral-900 group-hover:text-indigo-600 transition-colors"
            >
              <span>Explore Capability</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
            <span class="text-[10px] font-mono text-neutral-400">
              {service.tags[0]}
            </span>
          </div>

        </div>
      ))}
    </div>

    <!-- Deep Breakdown Link -->
    <div class="mt-12 text-center">
      <a
        href="/services-detail"
        class="inline-flex items-center gap-2 text-sm font-semibold text-neutral-700 hover:text-indigo-600 hover:underline"
      >
        <span>View detailed service deliverables &amp; technical scope matrix</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>

  </div>
</section>
